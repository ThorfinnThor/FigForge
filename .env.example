# ADR-012: optional LEGO partner-link template for the Pick a Brick link.
# {url} is replaced with the URL-encoded Pick a Brick address. Leave empty to link directly.
# Never commit a real partner ID; set it in the Cloudflare Workers Builds environment instead.
VITE_LEGO_AFFILIATE_LINK_TEMPLATE=
VITE_AMAZON_ASSOCIATE_TAG=
VITE_AMAZON_ASSOCIATE_SEARCH_URL=https://www.amazon.de/s
