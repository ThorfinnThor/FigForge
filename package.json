{
  "name": "figforge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "catalog:local": "python3 tools/run_local_catalog_pipeline.py",
    "catalog:local:test": "python3 -m unittest tests/python/test_local_catalog_pipeline.py",
    "review:ff18": "tsx tools/ff18-review-server.ts",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "data:validate": "tsx tools/validate-sources.ts",
    "data:validate:ff03": "tsx tools/validate-ff03-assortment.ts",
    "data:validate:ff05": "tsx tools/validate-ff05-anchors.ts",
    "data:validate:ff06": "tsx tools/validate-ff06-procurement.ts",
    "data:validate:ff16": "tsx tools/validate-ff16-compatibility.ts",
    "data:validate:ff17": "tsx tools/validate-ff17-search.ts",
    "data:build:ff18": "tsx tools/build-ff18-search-indices.ts",
    "data:validate:ff18": "tsx tools/validate-ff18-search.ts",
    "data:build:ff21": "tsx tools/build-ff21-search-artifacts.ts",
    "data:validate:ff21": "tsx tools/validate-ff21-search.ts",
    "search:benchmark:preflight": "tsx tools/check-ff18-prerequisites.ts",
    "data:validate:generated": "tsx tools/validate-generated-catalog.ts",
    "data:build:catalog-packages": "tsx tools/build-catalog-packages.ts",
    "data:review:mappings": "tsx tools/review-mappings.ts",
    "data:validate:mappings": "tsx tools/validate-mapping-review.ts",
    "assets:build": "tsx tools/build-assets.ts",
    "assets:prototype-map": "tsx tools/build-ldraw-prototype-file-map.ts",
    "assets:prototype-pack": "tsx tools/build-ldraw-prototype-pack.ts",
    "assets:ldraw-thumbnails": "tsx tools/build-ldraw-catalog-thumbnails.ts",
    "assets:ldraw-refresh": "tsx tools/refresh-ldraw-library.ts",
    "assets:ldraw-expanded": "tsx tools/build-ldraw-expanded-catalog.ts",
    "assets:validate:ldraw-expanded": "tsx tools/validate-ldraw-expanded-catalog.ts",
    "assets:analyze:ldraw-coverage": "tsx tools/analyze-ldraw-catalog-coverage.ts",
    "assets:validate:ldraw-coverage": "tsx tools/validate-ldraw-catalog-coverage.ts",
    "assets:analyze:placement-candidates": "tsx tools/analyze-ldraw-placement-candidates.ts",
    "assets:validate:placement-candidates": "tsx tools/validate-ldraw-placement-candidates.ts",
    "assets:build:fit-review": "tsx tools/build-ldraw-fit-review.ts",
    "assets:validate:fit-review": "tsx tools/validate-ldraw-fit-review.ts",
    "assets:build:connectivity": "tsx tools/build-ldraw-digital-connectivity.ts",
    "assets:validate:connectivity": "tsx tools/validate-ldraw-digital-connectivity.ts",
    "assets:validate": "tsx tools/validate-assets.ts",
    "licenses:build": "tsx tools/build-asset-manifest.ts",
    "licenses:validate": "tsx tools/validate-asset-manifest.ts",
    "data:refresh": "tsx tools/refresh-catalog.ts --check-only",
    "data:refresh:remote": "tsx tools/refresh-catalog.ts --refresh",
    "cf:check": "tsx tools/check-cloudflare.ts",
    "verify": "npm run catalog:local:test && npm run data:validate && npm run data:validate:ff03 && npm run data:validate:ff05 && npm run data:validate:ff06 && npm run data:validate:ff16 && npm run data:validate:ff17 && npm run data:validate:ff18 && npm run data:validate:ff21 && npm run data:validate:generated && npm run data:validate:mappings && npm run assets:validate && npm run assets:validate:fit-review && npm run assets:validate:connectivity && npm run assets:validate:ldraw-expanded && npm run assets:validate:ldraw-coverage && npm run assets:validate:placement-candidates && npm run licenses:validate && npm run typecheck && npm run lint && npm run test && npm run build && npm run cf:check"
  },
  "dependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@huggingface/transformers": "^4.3.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "sharp": "0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.141.0",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260925.1": true,
    "fsevents@2.3.3": true
  }
}
