{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "figforge",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": false
  }
}
